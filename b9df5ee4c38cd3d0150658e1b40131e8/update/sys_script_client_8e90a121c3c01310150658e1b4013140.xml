        <description>Auto populate manager when clicking requested by</description>
        <field>requested_by</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Auto populate manager</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading) {
        return;
    }
    if (newValue === '') {
        g_form.clearValue('manager');
        return;
    }
    g_form.getReference('requested_by', function (user) {
        g_form.setValue('manager', user.manager);
    });
}]]></script>
