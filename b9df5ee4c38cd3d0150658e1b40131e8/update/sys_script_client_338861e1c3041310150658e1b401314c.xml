        <name>Number colour by status</name>
        <order/>
        <script><![CDATA[function onLoad() {
    var map = {
        approved:  { bg: 'green',     fg: 'white' },
        rejected:  { bg: 'red',       fg: 'white' },
        cancelled: { bg: 'lightblue', fg: 'black' }
    };

    var status = String(g_form.getValue('status')).toLowerCase();
    var c = map[status];
    if (!c) {
        return;
    }

    var control = g_form.getControl('number');
    if (control) {
        control.style.backgroundColor = c.bg;
        control.style.color = c.fg;
    }
}]]></script>
